NODE_ENV=development
# En Render (y la mayoría de los PaaS) no hace falta setear esto — inyectan su propio `PORT`, que
# gana sobre este valor (ver `packages/validation/src/env/cloud-backend-env.schema.ts`). Solo se
# usa en local/Docker, donde `PORT` no existe.
CLOUD_BACKEND_PORT=38200

# Connection string de Postgres — en producción, Neon (ver render.yaml y
# docs/monetization/ADS_CREDITS_GAMIFICATION.md §6; agregar `?sslmode=require` a la URL de Neon).
# Para desarrollo local, cualquier Postgres 14+ (ej. `docker run -p 5432:5432 postgres:16`) — la
# SSL de producción se activa sola con NODE_ENV=production (`database.module.ts`), nunca en dev.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stocknegozia_cloud

LOG_LEVEL=info

# Orígenes CORS permitidos, separados por coma (panel de administración en dev/prod, futuros
# clientes mobile-mini). Ver apps/backend/.env.example para el mismo patrón.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Firma los JWT de sesión del panel de administración — generar con, por ejemplo,
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
ADMIN_JWT_SECRET=

# Firma los JWT de sesión de las cuentas de comercio (`users`) — nunca el mismo valor que
# ADMIN_JWT_SECRET. Generar igual que el de arriba.
ACCOUNT_JWT_SECRET=

# Solo usadas por `pnpm run db:seed` para crear el primer admin (idempotente, no pisa uno
# existente). Dejar vacías para omitir ese paso del seed.
# ADMIN_SEED_EMAIL=admin@stocknegozia.com
# ADMIN_SEED_PASSWORD=

# Proveedor real de email: API REST de Gmail por HTTPS (OAuth2), no SMTP ni Resend/SendGrid —
# opcional. Sin esto, `EmailService` sigue logueando el email en vez de mandarlo (igual que siempre
# en dev), sin romper nada. El SMTP real de Gmail evitaba el problema de spam (Resend/SendGrid no
# pueden alinear SPF/DKIM para un remitente @gmail.com sin dominio propio), pero Render bloquea los
# puertos SMTP salientes en el plan free — la API REST usa HTTPS normal (443), nunca bloqueado. Ver
# docs/monetization/ADS_CREDITS_GAMIFICATION.md §3 para el paso a paso de cómo conseguir estas
# credenciales en Google Cloud Console.
# GMAIL_USER=tuemail@gmail.com
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
