---
import { faq } from "../data/faq";
---

<section id="preguntas-frecuentes" class="bg-white py-24">
  <div class="container-page max-w-3xl">
    <p class="eyebrow">Preguntas frecuentes</p>
    <h2 class="mt-3 text-3xl font-bold text-ink-950 sm:text-4xl">
      Lo que más nos preguntan
    </h2>

    <div class="mt-10 divide-y divide-ink-200 border-t border-ink-200">
      {
        faq.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-base font-medium text-ink-950 marker:content-none">
              {item.question}
              <svg
                width="18"
                height="18"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
                class="shrink-0 text-ink-400 transition-transform group-open:rotate-45"
              >
                <path
                  d="M8 3v10M3 8h10"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            </summary>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-600">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
