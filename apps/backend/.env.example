NODE_ENV=development
STOCKNEGOZIA_PORT=38123
# STOCKNEGOZIA_DATA_DIR=C:\Users\<user>\AppData\Roaming\StockNegozia

# Logging estructurado — ver docs/logging/LOGGING.md
LOG_LEVEL=info
# LOG_DIR por defecto es <dataDir>/logs (el mismo dataDir que usan SQLite/config/plugins).
# Descomentar para usar otra ubicación.
# LOG_DIR=./logs
LOG_PERSISTENCE=true
LOG_CONSOLE=true

# Control de acceso a la API — ver docs/security/API_ACCESS.md
# development = endpoints abiertos sin credential (browser, Postman, Electron) para desarrollar sin fricción.
# production  = todo endpoint de negocio exige `Authorization: Bearer <credential>` de un dispositivo activo.
API_ACCESS_MODE=development
