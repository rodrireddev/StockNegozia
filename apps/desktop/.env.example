# URL de apps/cloud-backend — usada por el banner pasivo del sidebar derecho (house ad) y por
# "Beneficios" (cuenta cloud, doc monetization/ADS_CREDITS_GAMIFICATION.md §6). Es independiente
# del backend local (SQLite + LAN pairing): ese lo inyecta Electron vía preload, no un env var de
# Vite — ver renderer/src/lib/api-client.ts vs. renderer/src/lib/cloud-api-client.ts.
VITE_CLOUD_BACKEND_URL=http://localhost:38200

# Site key pública de Cloudflare Turnstile — obligatoria para registrarse/resetear contraseña,
# igual que en apps/mobile-mini (ver TurnstileWidget.tsx). Sin esta variable el widget nunca
# resuelve el challenge, así que register/password-reset no pueden completarse.
VITE_TURNSTILE_SITE_KEY=
