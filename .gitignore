# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
release/
# Backend armado para el instalador de Desktop (apps/desktop/scripts/prepare-backend-bundle.mjs)
build-resources/
# APKs e instaladores generados para testear/subir como release
releases/
*.tsbuildinfo

# Turborepo
.turbo/

# Vercel (project link metadata, machine/account-specific)
.vercel/

# Database (local dev data — never commit real data)
apps/backend/data/
apps/backend/data-*/
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db

# Bootstrap token de instalación (ver docs/security/API_ACCESS.md) — secreto de un solo uso, nunca
# se versiona sin importar en qué dataDir de prueba haya quedado.
bootstrap.token

# Env (keep .env.example tracked as documentation)
.env
.env.*
!.env.example

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Test/lint caches
coverage/
.nyc_output/
.eslintcache

# Claude Code local settings (machine-specific, not shared)
.claude/settings.local.json

# Editor/OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
