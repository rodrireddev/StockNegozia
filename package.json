{
  "name": "stocknegozia",
  "private": true,
  "version": "0.1.0",
  "description": "StockNegozia — plataforma modular de gestión empresarial (monorepo)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "turbo run dev --filter=@stocknegozia/desktop",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.19.0"
  }
}
